# Copiar a .env (NUNCA versionar .env -- ver .gitignore) y completar antes
# de correr en modo LIVE. Solo nombres de variable aca, sin valores reales.
#
# DRY_RUN no necesita ninguna de estas -- corre sin credenciales, sin este
# archivo. Sin LAS DOS primeras (con la frase exacta), el proceso se queda
# en DRY_RUN pase lo que pase.

# Gate LIVE (doble, ver docs/LIVE_MICRO_FAVORITE.md):
LIVE_MICRO_FAVORITE=
LIVE_MICRO_FAVORITE_CONFIRM=

# Credenciales (nombres DISTINTOS a scripts/live_trader.py y a live_micro/,
# a proposito -- ver docs/LIVE_MICRO_FAVORITE.md, seccion Aislamiento):
LIVE_MICRO_FAVORITE_PRIVATE_KEY=
LIVE_MICRO_FAVORITE_FUNDER=
LIVE_MICRO_FAVORITE_SIGNATURE_TYPE=
